# Copy this file to .env and fill in real values.
# Never commit .env

# MySQL
DB_HOST=localhost
DB_NAME=fpl_hub
DB_USER=root
DB_PASS=

# Google OAuth (login / signup)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost/fpl_hub/backend/google_callback.php

# Google Sheets OAuth (fetcher / sheets access)
GOOGLE_SHEETS_CLIENT_ID=your-sheets-client-id.apps.googleusercontent.com
GOOGLE_SHEETS_CLIENT_SECRET=your-sheets-client-secret
GOOGLE_SHEETS_REDIRECT_URI=http://localhost/fpl_hub/backend/callback.php

# Paths (relative to backend/ or absolute)
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json
